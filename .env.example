# Copy to .env to override the development defaults used by docker-compose.yml.
POSTGRES_DB=kanakku
POSTGRES_USER=kanakku
POSTGRES_PASSWORD=kanakku
MINIO_ROOT_USER=kanakku
MINIO_ROOT_PASSWORD=kanakku-dev-secret
# URL the browser uses to reach the app (served to the web as /config.json).
KANAKKU_API_BASE_URL=http://localhost:8080
# Origin(s) the app allows for CORS (comma separated, no wildcard).
KANAKKU_CORS_ALLOWED_ORIGINS=http://localhost:3000
# Required. Secret (32+ characters) that invite link tokens are derived from; generate your own,
# for example with `openssl rand -hex 32`. `make up-dev` uses a throwaway one when this is empty.
KANAKKU_INVITE_TOKEN_SECRET=
# Optional SMS provider for phone verification: a webhook that receives {"to": "+91...", "text": "..."}.
# Empty, phone numbers stay unverified. With a URL set, the code secret (32+ characters) is required,
# and the URL must be https unless its host is a loopback or private IP address or a single-word
# name such as localhost or a compose service name.
KANAKKU_SMS_WEBHOOK_URL=
KANAKKU_SMS_WEBHOOK_TOKEN=
KANAKKU_SMS_CODE_SECRET=
# Country calling codes that codes are sent to, comma separated; default 91 (India only). Widen on
# purpose, for example 91,1,44, since each country you add can be abused for SMS pumping.
KANAKKU_SMS_ALLOWED_CALLING_CODES=91
# Most codes the whole instance sends in an hour; past it sending answers 429. Default 200.
# Sign-up sends may use only the larger half, so profile verification keeps the rest.
KANAKKU_SMS_MAX_SENDS_PER_HOUR=200
