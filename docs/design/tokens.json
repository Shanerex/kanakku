  "palette": {
    "$description": "The ten identity colours used for groups, avatars and categories. `solid` is for chart marks, icons on surface, borders and accent bars, never behind text. `tint` (light) and `tint-dark` (dark) are identity backgrounds; `ink` (light) and `ink-dark` (dark) are text and icons on that tint, at >= 4.5:1. Avatars and group badges are always ink-on-tint.",
    "violet":    { "solid": "#6D4AFF", "tint": "#E6E0FF", "tint-dark": "#2C2452", "ink": "#4527B3", "ink-dark": "#C4B6FF" },
    "grape":     { "solid": "#A23ECF", "tint": "#F4E3FB", "tint-dark": "#3A1F47", "ink": "#7A2A9E", "ink-dark": "#E2B5F5" },
    "pink":      { "solid": "#E0457B", "tint": "#FCE4EC", "tint-dark": "#46202D", "ink": "#A8295A", "ink-dark": "#FFADC8" },
    "coral":     { "solid": "#E8594F", "tint": "#FDE5E3", "tint-dark": "#40211F", "ink": "#B0362D", "ink-dark": "#FFA59E" },
    "tangerine": { "solid": "#E8730C", "tint": "#FFEBD9", "tint-dark": "#43280F", "ink": "#A34E05", "ink-dark": "#FFBC80" },
    "mango":     { "solid": "#B87D00", "tint": "#FFF3D6", "tint-dark": "#3A2C0C", "ink": "#7D5600", "ink-dark": "#FFD36B" },
    "lime":      { "solid": "#5E9E1A", "tint": "#E9F6D9", "tint-dark": "#25331A", "ink": "#3F6D0F", "ink-dark": "#B6E87A" },
    "mint":      { "solid": "#12A37F", "tint": "#DCF5EE", "tint-dark": "#123A31", "ink": "#0B7A5E", "ink-dark": "#7FE6C6" },
    "teal":      { "solid": "#0E8EA6", "tint": "#D9F2F7", "tint-dark": "#0F333B", "ink": "#0A6677", "ink-dark": "#7FD6E8" },
    "sky":       { "solid": "#2E7CF6", "tint": "#E0ECFF", "tint-dark": "#14284A", "ink": "#1A56C0", "ink-dark": "#9CC2FF" }
  },
  "font": {
    "family": {
      "display": "\"Baloo 2\", \"Nunito\", ui-rounded, system-ui, sans-serif",
      "body": "\"Nunito\", ui-rounded, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
      "mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace"
    },
    "weight": { "regular": 400, "medium": 600, "bold": 700, "heavy": 800 },
    "size": {
      "display": "40px",
      "h1": "28px",
      "h2": "22px",
      "h3": "18px",
      "body": "16px",
      "body-sm": "14px",
      "caption": "12px",
      "amount-xl": "40px",
      "amount-lg": "24px",
      "amount-md": "16px",
      "amount-sm": "14px"
    },
    "line-height": {
      "display": "44px",
      "h1": "34px",
      "h2": "28px",
      "h3": "24px",
      "body": "24px",
      "body-sm": "20px",
      "caption": "16px"
    }
  },
  "space": {
    "0": "0px", "0.5": "2px", "1": "4px", "2": "8px", "3": "12px", "4": "16px",
    "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px"
  },
  "radius": { "xs": "6px", "sm": "8px", "md": "12px", "lg": "16px", "xl": "24px", "pill": "999px" },
  "shadow": {
    "light": {
      "sm": "0 1px 2px rgba(45, 25, 120, 0.06), 0 1px 3px rgba(45, 25, 120, 0.08)",
      "md": "0 4px 12px rgba(45, 25, 120, 0.10)",
      "lg": "0 12px 32px rgba(45, 25, 120, 0.16)",
      "fab": "0 6px 16px rgba(109, 74, 255, 0.40)"
    },
    "dark": {
      "sm": "0 1px 2px rgba(0, 0, 0, 0.40)",
      "md": "0 4px 12px rgba(0, 0, 0, 0.45)",
      "lg": "0 12px 32px rgba(0, 0, 0, 0.55)",
      "fab": "0 6px 16px rgba(109, 74, 255, 0.45)"
    }
  },
  "motion": {
    "duration": { "instant": "80ms", "fast": "120ms", "base": "200ms", "slow": "320ms", "celebrate": "900ms" },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0, 0, 0, 1)",
      "exit": "cubic-bezier(0.3, 0, 1, 1)",
      "bounce": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  },
  "size": {
    "touch-target": "44px",
    "control-sm": "32px",
    "control-md": "44px",
    "control-lg": "52px",
    "avatar-xs": "20px",
    "avatar-sm": "28px",
    "avatar-md": "36px",
    "avatar-lg": "48px",
    "avatar-xl": "72px",
    "icon-sm": "16px",
    "icon-md": "20px",
    "icon-lg": "24px",
    "sidebar": "264px",
    "content-max": "960px",
    "sheet-max": "560px",
    "bottom-bar": "64px",
    "fab": "56px"
  },
  "breakpoint": { "sm": "360px", "md": "768px", "lg": "1024px", "xl": "1280px" },
  "z": { "base": 0, "sticky": 10, "nav": 20, "fab": 30, "sheet": 40, "dialog": 50, "toast": 60 }
}
